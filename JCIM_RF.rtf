import numpy as np\
import pandas as pd\
from sklearn.model_selection import train_test_split, StratifiedKFold\
from sklearn.metrics import roc_auc_score, average_precision_score\
from sklearn.ensemble import RandomForestClassifier\
\
\
# RF (Held-out 20% TEST + 5-fold CV on remaining 80%)\
df_all = pd.read_excel('Data.xlsx', sheet_name='Features-MIC')\
\
X = df_all.drop(columns=["SA"])\
y = (df_all[["SA"]] <= 8).astype(int)\
mic = "SA"   \
y_mic = y[mic].astype(int)\
\
# 20% held-out test\
X_80, X_test, y_80, y_test = train_test_split(\
    X, y_mic,\
    test_size=0.20,\
    random_state=0,\
    stratify=y_mic\
)\
\
# 5-fold CV on the 80% \
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=0)\
\
def get_scores(model, X):\
    if hasattr(model, "predict_proba"):\
        return model.predict_proba(X)[:, 1]\
    if hasattr(model, "decision_function"):\
        return model.decision_function(X)\
    return model.predict(X)\
\
# CV evaluation\
fold_auroc = []\
fold_auprc = []\
\
for tr_idx, va_idx in cv.split(X_80, y_80):\
    X_tr, X_va = X_80.iloc[tr_idx], X_80.iloc[va_idx]\
    y_tr, y_va = y_80.iloc[tr_idx], y_80.iloc[va_idx]\
\
    rf = RandomForestClassifier(random_state=0)\
    rf.fit(X_tr, y_tr)\
\
    scores = get_scores(rf, X_va)\
    fold_auroc.append(roc_auc_score(y_va, scores))\
    fold_auprc.append(average_precision_score(y_va, scores))\
\
print("AUROC mean:", round(np.mean(fold_auroc), 4), "std:", round(np.std(fold_auroc), 4))\
print("AUPRC mean:", round(np.mean(fold_auprc), 4), "std:", round(np.std(fold_auprc), 4))\
\
# Final RF trained on full 80% train split (after CV evaluation)\
rf_final = RandomForestClassifier(random_state=0)\
rf_final.fit(X_80, y_80)\
\
test_scores = get_scores(rf_final, X_test)\
print("TEST AUROC:", round(roc_auc_score(y_test, test_scores), 4))\
print("TEST AUPRC:", round(average_precision_score(y_test, test_scores), 4))\
\
\
# Predict activity labels (0/1) for generated molecules\
X_generated = pd.read_excel('Gen_Data.xlsx')\
X_generated = X_generated[X_80.columns]\
\
y_pred_generated = rf_final.predict(X_generated)\
\
out_df = pd.DataFrame(\{\
    "Molecule": np.arange(1, len(y_pred_generated) + 1),\
    "Predicted_SA": y_pred_generated\
\})\
\
out_df.to_excel("Predicted_SA.xlsx", index=False)}